# Copy to .env (never commit .env)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=agentcrash
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agentcrash
# OAuth 2.0 client secrets for the in-repo token endpoint (dev values; replace outside local use)
AUTH_RUNTIME_SECRET=dev-runtime-secret
AUTH_READONLY_SECRET=dev-readonly-secret
AUTH_OPERATOR_SECRET=dev-operator-secret
# Set to 1 to run the stack with token checks on
AGENTCRASH_AUTH=0
